{
  "name": "@isitfishy/api-client",
  "version": "0.1.0",
  "description": "Typed client for the isitfishy API, generated from its OpenAPI document",
  "private": true,
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}

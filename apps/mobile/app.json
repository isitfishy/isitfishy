{
  "expo": {
    "name": "IsItFishy",
    "slug": "isitfishy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.brkozer.isitfishy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.brkozer.isitfishy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "IsItFishy uses the camera only to read QR codes you choose to scan.",
          "recordAudioAndroid": false
        }
      ],
      "expo-share-intent",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1F5BFF"
        }
      ]
    ],
    "scheme": "isitfishy"
  }
}
